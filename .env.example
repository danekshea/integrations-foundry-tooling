SOURCE_CHAIN_TX_HASH=
DESTINATION_CHAIN_RPC_URL=
MAINNET=false
CAST_ACCOUNT=
# Optional: skip the keystore prompt by setting your password here. Leave
# commented out (or unset) to keep the interactive prompt. .env is gitignored.
# KEYSTORE_PASSWORD=
COMPOSE_VALUE_BUFFER_PERCENT=50

# ============================================
# Solana destination (make simulate-solana / broadcast-solana)
# ============================================
# Only needed when the message's destination is Solana. Params (guid, nonce,
# sender, receiver, srcEid, dstEid, value) are auto-fetched from Scan via
# SOURCE_CHAIN_TX_HASH above — nothing else to fill in.
# Fee-payer keypair (funds ATA rent + tx fees). Defaults to ~/.config/solana/id.json.
SOLANA_KEYPAIR=
# Solana RPC. Defaults to public mainnet/devnet based on MAINNET. Use a private RPC for reliability.
SOLANA_RPC_URL=
# Optional: override lamports funded for delivery. Default = source option value,
# floored to 2,500,000 (~0.0025 SOL) to cover ATA creation. Bump if the OFT creates
# multiple rent-exempt accounts.
SOLANA_VALUE_LAMPORTS=
# Optional: compute unit limit (default 200000).
SOLANA_COMPUTE_UNITS=

# ============================================
# Starknet destination (make simulate-starknet / broadcast-starknet)
# ============================================
# Only needed when the message's destination is Starknet. Params (guid, nonce,
# sender, receiver, srcEid, dstEid, value) are auto-fetched from Scan via
# SOURCE_CHAIN_TX_HASH above. Requires `sncast` (Starknet Foundry) on PATH.
# Starknet cannot reuse CAST_ACCOUNT's key (different curve, different address derivation),
# but it CAN reuse the cast keystore: Foundry and starkli share the v3 eth-keystore format,
# and sncast reads the same KEYSTORE_PASSWORD. Recommended setup (see README) -- the key
# stays encrypted in ~/.foundry/keystores instead of plaintext in sncast's accounts file:
#   STARKNET_KEYSTORE=$HOME/.foundry/keystores/starknet-burner
#   STARKNET_ACCOUNT=$HOME/.starknet_accounts/burner.account.json
# With a keystore, STARKNET_ACCOUNT is a path to the starkli account JSON (address +
# class hash + public key, no secret). The account must be deployed + funded with STRK.
STARKNET_KEYSTORE=
STARKNET_ACCOUNT=
# Alternative to the above: a plain sncast account name from `sncast account create/import`,
# which stores the key in PLAINTEXT at ~/.starknet_accounts/. Optionally point elsewhere:
STARKNET_ACCOUNTS_FILE=
# Starknet RPC. Defaults to a public endpoint based on MAINNET. Use a private RPC for reliability.
STARKNET_RPC_URL=
# Optional: override the EndpointV2 address (default: resolved from the LZ metadata API).
STARKNET_ENDPOINT=
# Optional: override the value (wei) forwarded to the OApp. Default = source option value.
# Any non-zero value is pulled from your account via transfer_from, so the script
# approves the endpoint on STRK first.
STARKNET_VALUE=
# Optional: override the fee/value token (default STRK).
STARKNET_NATIVE_TOKEN=
# Optional: proceed even when ExecutionState is not Executable.
STARKNET_FORCE=

# Optional: gas estimate multiplier as a percentage for --broadcast targets.
# Adds headroom where forge's gas estimate is too low and the tx runs out of gas
# (e.g. Sei). Leave empty to use forge's default. Example: 300 = 3x estimate.
GAS_ESTIMATE_MULTIPLIER=
